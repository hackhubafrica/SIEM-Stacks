{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "SIEM - Suricata & Zeek (Loki)",
  "tags": ["siem", "loki"],
  "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "id": null,
  "uid": null,
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
      {"id": 1, "type": "table", "title": "Suricata Alerts", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0}, "targets": [{"expr": "{job=\"siem\",sensor=\"sensor-suricata\",event_type=\"evt-alert\"}", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "options": {"showHeader": true}},
      {"id": 2, "type": "bargauge", "title": "Suricata Alert Severity", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10}, "targets": [{"expr": "sum by (alert_severity) (count_over_time({job=\"siem\",sensor=\"sensor-suricata\",event_type=\"evt-alert\"} | json [5m]))", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}},
      {"id": 3, "type": "bargauge", "title": "Top Suricata Signatures", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10}, "targets": [{"expr": "topk(10, sum by (alert_signature) (count_over_time({job=\"siem\",sensor=\"sensor-suricata\",event_type=\"evt-alert\"} | json [1h])))", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}},
      {"id": 4, "type": "table", "title": "Zeek DNS Queries", "gridPos": {"h": 10, "w": 12, "x": 0, "y": 18}, "targets": [{"expr": "{job=\"siem\",sensor=\"sensor-zeek\"} | json | event_type=\"dns\"", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "options": {"showHeader": true}},
      {"id": 5, "type": "table", "title": "Zeek HTTP Transactions", "gridPos": {"h": 10, "w": 12, "x": 12, "y": 18}, "targets": [{"expr": "{job=\"siem\",sensor=\"sensor-zeek\"} | json | event_type=\"http\"", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "options": {"showHeader": true}},
      {"id": 6, "type": "table", "title": "TLS / JA3 Handshakes", "gridPos": {"h": 10, "w": 12, "x": 0, "y": 28}, "targets": [{"expr": "{job=\"siem\",sensor=\"sensor-zeek\"} | json | event_type=\"ssl\"", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "options": {"showHeader": true}},
      {"id": 7, "type": "bargauge", "title": "Zeek Connection States", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}, "targets": [{"expr": "sum by (conn_state) (count_over_time({job=\"siem\",sensor=\"sensor-zeek\"} | json | event_type=\"conn\" [5m]))", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}},
      {"id": 8, "type": "bargauge", "title": "TLS Server Names (SNI)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36}, "targets": [{"expr": "topk(10, sum by (server_name) (count_over_time({job=\"siem\",sensor=\"sensor-zeek\"} | json | event_type=\"ssl\" [1h])))", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}},
      {"id": 9, "type": "table", "title": "Suricata Stats", "gridPos": {"h": 10, "w": 12, "x": 12, "y": 36}, "targets": [{"expr": "{job=\"siem\",sensor=\"sensor-suricata\",event_type=\"evt-stats\"}", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "options": {"showHeader": true}},
      {"id": 10, "type": "timeseries", "title": "Event Rate (events/min)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 46}, "targets": [{"expr": "sum(rate({job=\"siem\"}[1m])) * 60", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}},
      {"id": 11, "type": "bargauge", "title": "Top Talkers (src IP)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 46}, "targets": [{"expr": "topk(10, sum by (id_orig_h) (count_over_time({job=\"siem\",sensor=\"sensor-zeek\"} | json | event_type=\"conn\" [5m])))", "refId": "A"}], "datasource": {"type": "loki", "uid": "${DS_LOKI}"}}
  ]
}
